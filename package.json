{
  "name": "family-computing",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json --composite false",
    "preview": "vite preview",
    "tauri": "tauri",
    "pwa:icons": "pwa-assets-generator --config pwa-assets.config.ts && mv public/icon-192.png public/icon-512.png public/maskable-512.png public/apple-touch-icon-180.png public/pwa/"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "1.77.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "4.21.0",
    "textarea-caret": "3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "1.4.4",
    "@types/omggif": "1.0.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/textarea-caret": "3.0.4",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/headless": "6.0.0",
    "omggif": "1.0.10",
    "pngjs": "7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
